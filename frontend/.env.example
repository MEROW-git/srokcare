# FixKH Frontend Environment Variables

# Backend API Base URL (Java Spring Boot)
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Use the real Spring Boot API by default. Set true only for an isolated local demo.
VITE_USE_MOCK_API=false

# Road maps use OpenFreeMap without an API key.

# Optional: suggest nearby street names when a report pin is moved.
# VITE_MAPTILER_API_KEY=your_maptiler_browser_key
