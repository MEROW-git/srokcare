# FixKH Frontend Environment Variables

# Backend API Base URL (Java Spring Boot)
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Set false to use Spring Boot and the real registration email-code flow.
VITE_USE_MOCK_API=true

# Optional browser map key from MapTiler Cloud. Restrict its allowed HTTP origins.
# Without it, maps use the existing CARTO basemap.
# VITE_MAPTILER_API_KEY=your_maptiler_browser_key
